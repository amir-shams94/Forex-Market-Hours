{
  "manifest_version": 3,
  "name": "Forex Market Hours",
  "short_name": "FX Hours",
  "version": "1.2.0",
  "description": "Live open/close status with holiday & half-day awareness, country silhouettes, local time and countdowns for global Forex sessions (London, New York, Tokyo, Sydney, Frankfurt and any market you add).",
  "author": "Amirreza Shahbazi <amirreza.sh94@gmail.com>",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Forex Market Hours",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.tradinghours.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
